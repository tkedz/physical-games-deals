{
  "name": "physical-games-deals",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "npm run local:start",
    "dev": "next dev",
    "dev:hosted": "node --env-file=.env.hosted.local scripts/dev-hosted.mts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test.mts run",
    "db:new": "supabase migration new",
    "db:push": "supabase db push --linked",
    "db:status": "supabase migration list --linked",
    "db:check": "supabase db advisors --linked --type security --fail-on error",
    "local:start": "node scripts/local/start.mts",
    "local:stop": "supabase stop",
    "local:up": "supabase migration up --local",
    "local:reset": "node scripts/local/reset.mts",
    "collect": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/collector/collect.mts",
    "collect:import": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/collector/import-jsonl.mts",
    "catalog:probe": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/catalog/probe.mts",
    "extract": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/extract/extract.mts",
    "extract:eval": "node --env-file-if-exists=.env.local scripts/extract/eval.mts",
    "extract:report": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/extract/report.mts",
    "extract:report:hosted": "node --env-file=.env.hosted.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/extract/report.mts",
    "e2e:account": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/account.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "^3.13.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
