# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# staging directory for the collector code — never committed
_incoming/

# the labelled set's working files — the posts exported from collected_posts
# and the evaluation reports, both carrying post text — are never committed.
# Committed are its labels.json, the invented synthetic-posts.json, the eval
# record result.json (fingerprints and per-item outcomes, no post text) and
# export-posts.sql, the query that rebuilds posts.json
/scripts/extract/eval/*
!/scripts/extract/eval/labels.json
!/scripts/extract/eval/result.json
!/scripts/extract/eval/synthetic-posts.json
!/scripts/extract/eval/export-posts.sql

# the review samples npm run extract:report writes quote the posts too, and are
# never committed
/scripts/extract/review/
