# Copy this file as .env.local and fill in the values from the Supabase dashboard.
# .env.local is gitignored — .env.example (this file) is committed.
# Never paste these values into chat or into code.

# --- Supabase: Project Settings -> API ---
# Public, they reach the browser. Safe only because RLS guards access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Secret (sb_secret_...): NEVER with the NEXT_PUBLIC_ prefix ---
# Bypasses RLS. Destination: GitHub Actions secrets (the collector), not the browser.
# The collector's only write path: it never uses DATABASE_URL.
# Needed locally only if you run the collector from your own machine.
SUPABASE_SECRET_KEY=

# --- Supabase: Project Settings -> Database -> Connection string ---
# For migrations only. Contains the database password.
DATABASE_URL=

# --- Game catalogue (FR-003) — to be filled in once we pick a provider ---
# IGDB (via a Twitch application) or RAWG. Empty for now.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Deal extraction from posts (has_ai) ---
# We will pick the model when we build the extractor.
ANTHROPIC_API_KEY=
