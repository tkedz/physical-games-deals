# Copy this file as .env.local and fill it in. .env.local holds the local Supabase stack's
# values, and every local run reads it: npm run dev, a local build + start, the scripts.
# .env.local and .env.hosted.local (below) are gitignored — .env.example (this file) is committed.
# Never paste these values into chat or into code.
#
# `vercel env pull` writes .env.local unless given a file name, which would put Vercel's values
# here and make the guard refuse npm run dev and the scripts. Pull into another file:
# `vercel env pull .env.vercel.local`.

# --- Supabase: the local stack, from `npx supabase status` ---
# Run it in your own terminal once `npm run local:start` has started the stack, never through
# an agent: it prints the local keys.
# Public, they reach the browser. Safe only because RLS guards access.
# Project URL (http://127.0.0.1:54321), then Publishable:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_TARGET stays unset here: unset means the local stack, and the guard
# (src/lib/env/supabase-target.ts) refuses any other URL.

# --- Secret (sb_secret_...): NEVER with the NEXT_PUBLIC_ prefix ---
# Bypasses RLS. Here: the local stack's Secret, from the same `npx supabase status`.
# Read by the scripts' client (scripts/collector/supabase.mts): npm run collect, collect:import,
# extract and extract:report. The hosted one lives in .env.hosted.local and in the GitHub Actions
# secrets (the collect workflow) — never on Vercel, never in the browser.
SUPABASE_SECRET_KEY=

# --- Game catalogue (FR-003) — RAWG ---
# Server-only: NEVER with the NEXT_PUBLIC_ prefix. Get it at https://rawg.io/apidocs.
# It travels in the request URL (?key=), so request URLs are never logged.
# Destinations: Vercel project env, Production and Preview (the /watchlist search, since S-03), and here
# (npm run dev, npm run catalog:probe). Whether the pipeline needs it is S-04's call.
RAWG_API_KEY=

# --- Deal extraction from posts (has_ai) — OpenRouter ---
# Server-only: NEVER with the NEXT_PUBLIC_ prefix. Create it at https://openrouter.ai/settings/keys
# with a monthly credit limit — the limit is what caps a runaway loop.
# Destinations: GitHub Actions secrets (the extract step) and here (the extract scripts).
OPENROUTER_API_KEY=

# --- E2E tests (Playwright) — a test user in the local stack only ---
# Read by playwright.config.ts, which loads this file's .env.local and refuses a Supabase URL
# that is not the local stack. tests/e2e/auth.setup.ts signs in with them. Create the user by
# signing up at /signup on the local app; npm run local:reset deletes it.
E2E_USERNAME=
E2E_PASSWORD=
# Optional: the port the E2E build is served on, when 3000 (next start's default) is taken.
# E2E_PORT=

# --- .env.hosted.local: the hosted project (production) — a second file, not this one ---
# Read only by npm run dev:hosted and npm run extract:report:hosted, through node's --env-file;
# both stop when the file is missing. The three Supabase values come from the hosted project's
# dashboard (Project Settings -> API). It holds exactly these four lines:
#   NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#   SUPABASE_SECRET_KEY=
#   SUPABASE_TARGET=hosted
# Everything else stays in .env.local only: under dev:hosted, Next still reads .env.local for
# every name .env.hosted.local does not set, RAWG_API_KEY among them.
#
# The swap, for a .env.local that still holds the hosted values: move its three Supabase lines
# into a new .env.hosted.local, add SUPABASE_TARGET=hosted there, and refill the three in
# .env.local from `npx supabase status`.
